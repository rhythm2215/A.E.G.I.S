# ============================================================
# A.E.G.I.S. Frontend Environment Variables
# ============================================================

# URL of the deployed FastAPI Backend (e.g. on Railway)
VITE_API_URL=https://backend-production-xxxx.up.railway.app

# WebSocket URL of the deployed FastAPI Backend
# Note: If omitted, this will be automatically derived from VITE_API_URL
VITE_WS_URL=wss://backend-production-xxxx.up.railway.app/ws
