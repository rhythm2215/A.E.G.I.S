# ============================================================
# A.E.G.I.S. Backend Environment Configuration
# ============================================================

# Primary camera architecture: Browser-based WebRTC/MediaStream client ingest
CAMERA_SOURCE=browser

# Optional remote RTSP / HTTP network camera stream URL (leave empty if using browser camera only)
CAM_MB_URL=

# AI Facial Recognition & Biometric Pipeline Config
MIN_MATCH_CONFIDENCE=0.80
SFACE_THRESHOLD=0.38
AI_SCAN_INTERVAL_FRAMES=2
FRAME_RESIZE_SCALE=0.5
